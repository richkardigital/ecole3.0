{
  "name": "ecole3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "db:push-supabase": "npm --prefix server run db:push-supabase",
    "postinstall": "cd server && npx prisma@5.21.0 generate"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "@prisma/client": "^5.21.0",
    "@supabase/supabase-js": "^2.91.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "prisma": "^5.21.0",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "xss-clean": "^0.1.4",
    "zod": "^4.3.5"
  }
}
