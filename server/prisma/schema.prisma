generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================
// ENUMS
// =============================================

enum UserRole {
  SUPER_ADMIN
  DIRECTEUR
  EDUCATEUR
  ENSEIGNANT
  APPRENANT
  PARENT // Accès lecture seule aux données de ses enfants
}

enum BulletinStatus {
  BROUILLON
  SOUMIS
  VALIDE
}

// Statuts du workflow bulletin individuel élève
enum BulletinEleveStatus {
  BROUILLON
  SOUMIS_ENSEIGNANT
  VALIDE_EDUCATEUR
  VALIDE_DIRECTEUR
  VALIDE_SUPER_ADMIN
  REJETE
}

// Type de note
enum GradeType {
  DEVOIR
  EVALUATION
  EXAMEN
  PARTICIPATION
  CONDUITE
  QUIZ
  INTERRO
}

enum ResourceType {
  PDF
  VIDEO
  AUDIO
  IMAGE
  LIEN
}

enum TermStatus {
  OPEN
  CLOSED
}

enum AcademicYearStatus {
  CREE
  EN_COURS
  ACHEVE
}

enum Gender {
  MASCULIN
  FEMININ
  AUTRE
}

enum AssignmentType {
  EXERCICE_MAISON
  DEVOIR_MAISON
  DEVOIR_CLASSE
  DEVOIR_NIVEAU
  COMPOSITION_NIVEAU
  COMPO_NIVEAU
  EXAMEN
}

// Type de quiz / évaluation
enum QuizType {
  EXERCICE_MAISON
  DEVOIR_MAISON
  DEVOIR_CLASSE
  DEVOIR_NIVEAU
  COMPOSITION_NIVEAU
  COMPO_NIVEAU
  EXAMEN
}

// Type de question
enum QuestionType {
  SINGLE_CHOICE    // QCM une seule réponse
  MULTIPLE_CHOICE  // QCM plusieurs réponses
  FILL_IN_BLANK    // À compléter (correction automatique par comparaison)
  OPEN             // Réponse libre (correction manuelle)
}

// Statut d'inscription
enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  SUSPENDED
}

// Portée du contenu pédagogique (modèle CNED)
enum ContentScope {
  NIVEAU // Publié par SUPER_ADMIN → diffusé à TOUS les élèves du niveau
  ECOLE  // Publié par l'école → diffusé à tous les élèves de l'école
  CLASSE // Publié par un enseignant → diffusé aux élèves de la classe
}

// Workflow de statut des devoirs
enum AssignmentWorkflowStatus {
  BROUILLON
  PUBLIE
  EN_CORRECTION
  CORRIGE
  CLOTURE // Date limite passée : plus de rendu possible
}

// Source d'une note (pour pondération 60%/40%)
enum GradeSource {
  ADMIN      // Note créée par SUPER_ADMIN (poids 60% dans la moyenne)
  ENSEIGNANT // Note créée par l'enseignant pour éval de classe (poids 40%)
}

// Type d'exercice dans un chapitre
enum ExerciseType {
  QCM          // Questionnaire à Choix Multiples
  VRAI_FAUX    // Vrai ou Faux
  TEXTE_LIBRE  // Réponse ouverte, correction manuelle
}

// =============================================
// TEACHING TYPE — Type d'enseignement
// =============================================

model TeachingType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]

  @@index([isActive])
}

// =============================================
// SCHOOL TYPE — Type d'établissement (Primaire, Collège, Lycée...)
// =============================================

model SchoolType {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools     School[]

  @@index([isActive])
}

// =============================================
// SUBSCRIPTION — Abonnement des Écoles
// =============================================

model Subscription {
  id          String   @id @default(uuid())
  name        String   @unique
  planKey     String   @unique // 'starter', 'pro', 'premium' etc.
  description String?
  price       Float    @default(0)
  period      String   @default("Mensuel") // Mensuel, Annuel, etc.
  features    String[] // Liste des fonctionnalités incluses
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools     School[]

  @@index([isActive])
}

// =============================================
// SCHOOL — Établissement scolaire
// =============================================

model School {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  ville       String?
  address     String?
  postalAddress String?
  phone       String?
  email       String?
  logoUrl     String?
  signatureUrl String?
  stampUrl    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Type d'enseignement & Type d'établissement
  teachingTypeId String?
  teachingType   TeachingType? @relation(fields: [teachingTypeId], references: [id], onDelete: SetNull)

  schoolTypeId   String?
  schoolType     SchoolType?   @relation(fields: [schoolTypeId], references: [id], onDelete: SetNull)

  // Directeur de l'école
  managerId String? @unique
  manager   User?   @relation("SchoolManager", fields: [managerId], references: [id])

  // Abonnement
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionStatus    String        @default("ACTIVE") // ACTIVE, EXPIRED, PENDING
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  // Relations
  users         User[]         @relation("SchoolUsers")
  classes       Class[]
  subjects      Subject[]
  academicYears AcademicYear[] @relation("SchoolAcademicYears")
  niveaux       Niveau[]
  news          News[]

  @@index([code])
  @@index([isActive])
  @@index([teachingTypeId])
}

// =============================================
// NIVEAU — Niveaux scolaires (6ème, 5ème, etc.)
// =============================================

model Niveau {
  id       String  @id @default(uuid())
  nom      String
  rang     Int     @default(0)
  isActive Boolean @default(true)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  classes     Class[]
  resources   Resource[]
  assignments Assignment[]
  quizzes     Quiz[]
  courses     Course[] @relation("NiveauCourses")
  annualAverages AnnualAverage[]

  @@unique([nom, schoolId])
  @@index([rang])
  @@index([isActive])
}

// =============================================
// USER — Utilisateur (tous les rôles)
// =============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(APPRENANT)
  isActive  Boolean  @default(true)
  isOnline  Boolean  @default(false)

  // Profil enrichi
  matricule   String?   @unique
  phone       String?
  parentPhone String?
  birthDate   DateTime?
  birthPlace  String?
  avatarUrl   String?
  address     String?
  gender      Gender?

  documents   UserDocument[]

  schoolId String?
  school   School? @relation("SchoolUsers", fields: [schoolId], references: [id], onDelete: SetNull)

  managedSchool School? @relation("SchoolManager")

  // Relations académiques
  // Cours dispensés
  teacherClasses TeacherClass[]
  enrollments    Enrollment[]
  grades         Grade[]
  submissions    Submission[]
  quizAttempts   QuizAttempt[]

  // Relations communication
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  // Relations forum
  forumPosts    ForumPost[]
  forumComments ForumComment[]

  // Relations bulletins (classe)
  submittedBulletins Bulletin[] @relation("BulletinSubmitter")
  validatedBulletins Bulletin[] @relation("BulletinValidator")

  // Relations bulletins individuels élève (workflow)
  bulletinsEleves                  BulletinEleve[]
  bulletinsElevesSoumis            BulletinEleve[] @relation("BulletinEleveSoumis")
  bulletinsElevesValideEducateur   BulletinEleve[] @relation("BulletinEleveValideEducateur")
  bulletinsElevesValideDirecteur   BulletinEleve[] @relation("BulletinEleveValideDirecteur")
  bulletinsElevesValideAdmin       BulletinEleve[] @relation("BulletinEleveValideAdmin")

  // Relations resources
  createdResources Resource[] @relation("ResourceCreator")

  // Relations vie scolaire
  absences Absence[]
  conducts Conduct[]

  // Audit
  auditLogs AuditLog[]

  // Relations Meeting / News
  hostedMeetings Meeting[] @relation("MeetingHost")
  authoredNews   News[]    @relation("NewsAuthor")

  // Quiz / Devoir créés
  createdQuizzes      Quiz[]       @relation("QuizCreator")
  createdAssignments  Assignment[] @relation("AssignmentCreator")

  // Progression chapitres
  chapterProgress ChapterProgress[]

  // Exercices créés et soumissions
  createdExercises    ChapterExercise[]    @relation("ExerciseCreator")
  exerciseSubmissions ExerciseSubmission[] @relation("ExerciseSubmitter")

  // Modèle CNED — Propagation des devoirs
  assignmentPropagations AssignmentPropagation[] @relation("StudentPropagations")

  // Modèle CNED — Correcteur d'un devoir
  assignmentsToCorrect Assignment[] @relation("AssignmentCorrector")

  // Modèle CNED — Moyennes annuelles
  annualAverages AnnualAverage[] @relation("StudentAnnualAverages")

  // Lien parent-enfant
  children ParentChild[] @relation("ParentUser")
  parents  ParentChild[] @relation("StudentUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([role])
  @@index([email])
  @@index([isActive])
}

// =============================================
// ACADEMIC YEAR — Année scolaire
// =============================================

model AcademicYear {
  id        String             @id @default(uuid())
  name      String             @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean            @default(false)
  isActive  Boolean            @default(true)
  status    AcademicYearStatus @default(CREE)

  schools School[] @relation("SchoolAcademicYears")

  terms       Term[]
  classes     Class[]
  assignments Assignment[]
  enrollments Enrollment[]
  annualAverages AnnualAverage[]
  courses     Course[]

  @@index([isCurrent])
  @@index([status])
}

// =============================================
// TERM — Trimestre
// =============================================

model Term {
  id        String     @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    TermStatus @default(OPEN)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  grades          Grade[]
  bulletins       Bulletin[]
  bulletinsEleves BulletinEleve[]
  conducts        Conduct[]
  assignments     Assignment[]
  quizzes         Quiz[]
  chapters        Chapter[]
  absences        Absence[]

  @@index([status])
  @@index([academicYearId])
}

// =============================================
// CLASS — Classe
// =============================================

model Class {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  niveauId String?
  niveau   Niveau? @relation(fields: [niveauId], references: [id], onDelete: SetNull)

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  // Relations
  enrollments     Enrollment[]
  teacherClasses  TeacherClass[]
  messages        Message[]
  bulletins       Bulletin[]
  bulletinsEleves BulletinEleve[]
  meetings        Meeting[]

  @@unique([name, schoolId])
  @@index([schoolId])
  @@index([niveauId])
  @@index([isActive])
}

// =============================================
// SUBJECT — Matière
// =============================================

model Subject {
  id          String  @id @default(uuid())
  name        String
  code        String?
  coefficient Int     @default(1)
  imageUrl    String?
  isActive    Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  courses        Course[]
  assignments    Assignment[]
  teacherClasses TeacherClass[]
  quizzes        Quiz[]
  resources      Resource[]

  @@unique([name, schoolId])
  @@index([isActive])
}

// =============================================
// TEACHER_CLASS — Affectation Enseignant ↔ Classe ↔ Matière
// =============================================

model TeacherClass {
  id String @id @default(uuid())

  teacherId String
  teacher   User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classId String
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, classId, subjectId])
  @@index([teacherId])
  @@index([classId])
}

// =============================================
// ENROLLMENT — Inscription d'un apprenant dans une classe
// =============================================

model Enrollment {
  id String @id @default(uuid())

  studentId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  status    EnrollmentStatus @default(ACTIVE)
  matricule String?
  joinedAt  DateTime @default(now())

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([academicYearId])
  @@index([status])
}

// =============================================
// COURSE — Cours (Contenu pédagogique global par Matière et Niveau)
// =============================================

model Course {
  id String @id @default(uuid())

  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  niveauId String
  niveau   Niveau @relation("NiveauCourses", fields: [niveauId], references: [id], onDelete: Cascade)

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  // Modèle CNED : portée + niveau + publication
  scope       ContentScope @default(NIVEAU)
  isPublished Boolean      @default(false)
  coefficient Int          @default(1)

  // Contenu du cours
  chapters    Chapter[]
  resources   Resource[]
  assignments Assignment[]
  quizzes     Quiz[]
  grades      Grade[]
  annualAverages AnnualAverage[] @relation("CourseAnnualAverages")
  absences    Absence[]

  @@unique([subjectId, niveauId])
  @@index([niveauId])
  @@index([scope])
}



// =============================================
// CHAPTER — Chapitre d'un cours
// =============================================

model Chapter {
  id        String   @id @default(uuid())
  title     String
  content   String?
  position  Int      @default(0)
  courseId   String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  termId    String?
  term      Term?    @relation(fields: [termId], references: [id], onDelete: SetNull)
  resources Resource[]
  progress  ChapterProgress[]
  exercises ChapterExercise[]
  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([termId])
}

// =============================================
// RESOURCE — Ressource pédagogique (ex-Material)
// =============================================

model Resource {
  id    String       @id @default(uuid())
  title String
  type  ResourceType @default(PDF)
  url   String
  source String?

  // Portée de la ressource
  isGlobal       Boolean      @default(false) // Rétro-compat. frontend; syncé avec scope
  isDownloadable Boolean      @default(true)
  isPublished    Boolean      @default(false) // Validation par l'administrateur
  scope          ContentScope @default(CLASSE) // Portée unifiée
  schoolId       String?      // Pour scope=ECOLE

  // Relations
  courseId  String?
  course   Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  niveauId String?
  niveau   Niveau? @relation(fields: [niveauId], references: [id], onDelete: SetNull)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?  @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([niveauId])
  @@index([subjectId])
  @@index([isGlobal])
  @@index([scope])
}

// =============================================
// ASSIGNMENT — Devoir
// =============================================

model Assignment {
  id            String   @id @default(uuid())
  title         String
  description   String?
  startDate     DateTime?  // Date d'ouverture (disponible à partir de)
  dueDate       DateTime   // Date limite de rendu
  timeLimit     Int?       // Durée en minutes (si applicable)
  points        Int        @default(20)
  coefficient   Int        @default(1)
  correctionUrl String?
  voiceNoteUrl  String?
  imageUrl      String?    // Image d'illustration
  autoGrade     Boolean    @default(false) // Si QCM → correction auto
  isNiveauWide  Boolean    @default(false) // Rétro-compat; syncé avec scope
  syncCalendar  Boolean    @default(true)  // Synchronisation automatique avec l'agenda élèves

  type          AssignmentType @default(DEVOIR_MAISON)

  // Modèle CNED : portée unifiée
  scope          ContentScope             @default(CLASSE)
  workflowStatus AssignmentWorkflowStatus @default(BROUILLON)
  schoolId       String? // Pour scope=ECOLE

  // Correcteur assigné (enseignant)
  correctorId String?
  corrector   User?   @relation("AssignmentCorrector", fields: [correctorId], references: [id], onDelete: SetNull)

  courseId String?
  course  Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  niveauId String?
  niveau  Niveau? @relation(fields: [niveauId], references: [id], onDelete: Cascade)

  subjectId String?
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  academicYearId String?
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  termId String?
  term Term? @relation(fields: [termId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  submissions  Submission[]
  grades       Grade[]
  questions    AssignmentQuestion[]
  propagations AssignmentPropagation[]

  attachments String[] @default([])
  published   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([courseId])
  @@index([niveauId])
  @@index([subjectId])
  @@index([academicYearId])
  @@index([termId])
  @@index([startDate])
  @@index([dueDate])
  @@index([type])
  @@index([scope])
  @@index([workflowStatus])
}

model AssignmentQuestion {
  id            String   @id @default(uuid())
  text          String
  type          String   @default("MULTIPLE_CHOICE")
  points        Int      @default(1)
  expectedAnswer String? @db.Text
  imageUrl      String?  // Image d'illustration de la question
  position      Int      @default(0)
  
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  options       AssignmentOption[]
  
  @@index([assignmentId])
}

model AssignmentOption {
  id         String   @id @default(uuid())
  text       String
  isCorrect  Boolean  @default(false)
  imageUrl   String?  // Image d'illustration de l'option (optionnel)
  
  questionId String
  question   AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@index([questionId])
}

// =============================================
// SUBMISSION — Soumission d'un devoir par un apprenant
// =============================================

model Submission {
  id          String   @id @default(uuid())
  content     String?
  fileUrl     String?
  submittedAt DateTime @default(now())

  studentId    String
  assignmentId String

  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  grade Grade?

  @@unique([studentId, assignmentId])
  @@index([studentId])
  @@index([assignmentId])
}

// =============================================
// GRADE — Note
// =============================================

model Grade {
  id          String      @id @default(uuid())
  value       Float
  coefficient Float       @default(1)
  comment     String?
  validated   Boolean     @default(false)
  type        GradeType   @default(DEVOIR)
  source      GradeSource @default(ADMIN) // ADMIN=60% ou ENSEIGNANT=40% dans les moyennes
  isGraded    Boolean     @default(true)  // false = exercice non noté (enseignant)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  termId       String?
  assignmentId String?
  courseId     String?

  term       Term?       @relation(fields: [termId], references: [id])
  assignment Assignment? @relation(fields: [assignmentId], references: [id])
  course     Course?     @relation(fields: [courseId], references: [id])

  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id])

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([termId])
  @@index([courseId])
  @@index([type])
  @@index([source])
}

// =============================================
// BULLETIN — Bulletin scolaire (workflow)
// =============================================

model Bulletin {
  id     String         @id @default(uuid())
  statut BulletinStatus @default(BROUILLON)

  classId String
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  termId String
  term   Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  moyenneClasse Float?

  // Qui a soumis
  submittedById String?
  submittedBy   User?    @relation("BulletinSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime?

  // Qui a validé
  validatedById String?
  validatedBy   User?    @relation("BulletinValidator", fields: [validatedById], references: [id])
  validatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, termId])
  @@index([statut])
}

// =============================================
// MESSAGE — Messagerie instantanée
// =============================================

model Message {
  id          String  @id @default(uuid())
  content     String
  senderId    String
  sender      User    @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String?
  recipient   User?   @relation("ReceivedMessages", fields: [recipientId], references: [id])
  classId     String?
  class       Class?  @relation(fields: [classId], references: [id])

  attachmentUrl  String?
  attachmentType String?

  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([classId])
}

// =============================================
// QUIZ — Évaluations en ligne
// =============================================

model Quiz {
  id          String    @id @default(uuid())
  title       String
  description String?
  coefficient Int       @default(1)
  published   Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  timeLimit   Int?
  imageUrl    String?   // Image d'illustration globale
  autoGrade   Boolean   @default(true)  // Notation automatique
  maxAttempts Int       @default(1)     // Nombre de tentatives max
  isNiveauWide Boolean  @default(false) // Rétro-compat; syncé avec scope

  type        QuizType  @default(DEVOIR_MAISON)

  // Modèle CNED
  scope          ContentScope @default(CLASSE)
  isPublished    Boolean      @default(false)
  workflowStatus String       @default("BROUILLON") // BROUILLON|PUBLIE|CLOTURE
  schoolId       String?      // Pour scope=ECOLE

  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Pour les devoirs de niveau (super admin)
  niveauId  String?
  niveau    Niveau?  @relation(fields: [niveauId], references: [id], onDelete: Cascade)

  termId    String?
  term      Term?    @relation(fields: [termId], references: [id], onDelete: SetNull)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("QuizCreator", fields: [createdById], references: [id], onDelete: SetNull)

  questions QuizQuestion[]
  attempts  QuizAttempt[]
  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([niveauId])
  @@index([termId])
  @@index([type])
  @@index([scope])
}

model QuizQuestion {
  id            String       @id @default(uuid())
  text          String
  type          QuestionType @default(SINGLE_CHOICE)
  points        Int          @default(1)
  correctAnswer String?      // Pour SINGLE_CHOICE / FILL_IN_BLANK
  imageUrl      String?      // Image attachée à la question
  position      Int          @default(0)

  quizId String
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId])
}

model QuizOption {
  id         String       @id @default(uuid())
  text       String
  imageUrl   String?      // Image attachée à l'option
  isCorrect  Boolean      @default(false)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(uuid())
  score       Float
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  studentId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  quizId String
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers QuizAnswer[]

  @@index([studentId])
  @@index([quizId])
}

model QuizAnswer {
  id              String       @id @default(uuid())
  attemptId       String
  attempt         QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions String[]
  isCorrect       Boolean
}

// =============================================
// NOTIFICATION
// =============================================

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  userId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

// =============================================
// FORUM — Publications et discussions
// =============================================

model ForumPost {
  id       String  @id @default(uuid())
  title    String
  content  String
  category String  @default("GENERAL")
  fileUrl  String?
  fileType String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments ForumComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([category])
}

model ForumComment {
  id      String @id @default(uuid())
  content String

  authorId String
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
}

// =============================================
// ABSENCE — Gestion des absences
// =============================================

model Absence {
  id        String   @id @default(uuid())
  date      DateTime
  hours     Float    @default(1)
  reason    String?
  justified Boolean  @default(false)

  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  termId    String?
  term      Term?    @relation(fields: [termId], references: [id], onDelete: SetNull)

  studentId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([date])
  @@index([courseId])
  @@index([termId])
}

// =============================================
// CONDUCT — Conduite (liée au bulletin)
// =============================================

model Conduct {
  id           String  @id @default(uuid())
  appreciation String?
  comment      String?
  grade        Float?

  studentId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  termId String
  term   Term   @relation(fields: [termId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, termId])
  @@index([studentId])
}

// =============================================
// AUDIT LOG — Traçabilité des actions
// =============================================

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String?  // Nom du modèle concerné
  entityId  String?  // ID de l'entité
  metadata  String?  // JSON stringifié (détails de l'action)
  ipAddress String?

  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// =============================================
// MEETING — Réunions et Classes virtuelles
// =============================================

model Meeting {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  link        String?
  
  hostId      String
  host        User     @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Cascade)
  
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hostId])
  @@index([classId])
}

// =============================================
// NEWS — Actualités et Annonces
// =============================================

model News {
  id              String   @id @default(uuid())
  title           String
  content         String
  imageUrl        String?
  priority        String   @default("NORMAL") // e.g. "INFO", "NORMAL", "URGENT", "FLASH"
  isActive        Boolean  @default(true)
  targetRoles     String[] @default(["ALL"]) // e.g. ["ALL"], ["SUPER_ADMIN"], ["DIRECTEUR"], ["EDUCATEUR"], ["ENSEIGNANT"], ["APPRENANT"]
  targetSchoolIds String[] @default([])

  authorId        String
  author          User     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  schoolId        String?
  school          School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([authorId])
  @@index([schoolId])
}

// =============================================
// USER DOCUMENT — Pièces jointes profil (Extrait de naissance, CNI, etc.)
// =============================================

model UserDocument {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  fileType  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// =============================================
// BULLETIN ELEVE — Bulletin individuel par élève (workflow multi-rôles)
// =============================================

model BulletinEleve {
  id String @id @default(uuid())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  termId String
  term   Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  classId String
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  statut BulletinEleveStatus @default(BROUILLON)

  // Données calculées
  moyenneGenerale   Float?
  noteConduite      Float?
  noteParticipation Float? // Moyenne des notes de participation par matière
  rangClasse        Int?
  nombreEleves      Int?
  totalAbsences     Int?    @default(0)
  absencesJustifiees Int?   @default(0)

  // Appréciations
  appreciationGenerale String? @db.Text
  commentaireEducateur String? @db.Text
  commentaireDirecteur String? @db.Text

  // Étape 1 — Soumission par l'enseignant
  soumisParId String?
  soumisPar   User?    @relation("BulletinEleveSoumis", fields: [soumisParId], references: [id])
  soumisAt    DateTime?

  // Étape 2 — Validation par l'éducateur
  valideEducateurParId String?
  valideEducateurPar   User?    @relation("BulletinEleveValideEducateur", fields: [valideEducateurParId], references: [id])
  valideEducateurAt    DateTime?

  // Étape 3 — Validation par le directeur
  valideDirecteurParId String?
  valideDirecteurPar   User?    @relation("BulletinEleveValideDirecteur", fields: [valideDirecteurParId], references: [id])
  valideDirecteurAt    DateTime?

  // Étape 4 — Validation finale super admin
  valideAdminParId String?
  valideAdminPar   User?    @relation("BulletinEleveValideAdmin", fields: [valideAdminParId], references: [id])
  valideAdminAt    DateTime?

  // Rejet
  rejetCommentaire String? @db.Text
  rejetPar         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, termId])
  @@index([studentId])
  @@index([termId])
  @@index([classId])
  @@index([statut])
}

// =============================================
// CHAPTER PROGRESS — Progression élève dans les chapitres
// =============================================

model ChapterProgress {
  id          String   @id @default(uuid())
  completed   Boolean  @default(false)
  completedAt DateTime?

  studentId String
  student   User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, chapterId])
  @@index([studentId])
  @@index([chapterId])
}

// =============================================
// ASSIGNMENT PROPAGATION — Trace de diffusion automatique (modèle CNED)
// Créée automatiquement lors de la publication d'un devoir de niveau/école/classe
// =============================================

model AssignmentPropagation {
  id           String @id @default(uuid())

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentPropagations", fields: [studentId], references: [id], onDelete: Cascade)

  notified    Boolean  @default(false)
  viewed      Boolean  @default(false)
  submitted   Boolean  @default(false)
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

// =============================================
// PARENT CHILD — Lien parent ↔ enfant
// =============================================

model ParentChild {
  id        String @id @default(uuid())

  parentId  String
  parent    User @relation("ParentUser", fields: [parentId], references: [id], onDelete: Cascade)

  studentId String
  student   User @relation("StudentUser", fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

// =============================================
// ANNUAL AVERAGE — Moyenne annuelle par élève et par matière
// =============================================

model AnnualAverage {
  id             String @id @default(uuid())

  studentId      String
  student        User   @relation("StudentAnnualAverages", fields: [studentId], references: [id], onDelete: Cascade)

  courseId       String
  course         Course @relation("CourseAnnualAverages", fields: [courseId], references: [id], onDelete: Cascade)

  niveauId       String?
  niveau         Niveau? @relation(fields: [niveauId], references: [id], onDelete: SetNull)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  subjectCoefficient Int @default(1)

  trim1Avg       Float? // Moyenne trimestre 1 (pondérée 60%/40%)
  trim2Avg       Float? // Moyenne trimestre 2
  trim3Avg       Float? // Moyenne trimestre 3
  annualAvg      Float? // Moyenne annuelle = (trim1 + trim2 + trim3) / 3

  calculatedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, courseId, academicYearId])
  @@index([studentId])
  @@index([courseId])
  @@index([academicYearId])
  @@index([niveauId])
}

// =============================================
// CHAPTER EXERCISE — Exercice dans un chapitre
// =============================================

model ChapterExercise {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  type        ExerciseType @default(QCM)
  isGraded    Boolean      @default(false)
  coefficient Float        @default(1)
  timeLimit   Int?         // minutes (null = pas de limite)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ExerciseCreator", fields: [createdById], references: [id], onDelete: Cascade)

  questions   ExerciseQuestion[]
  submissions ExerciseSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([createdById])
}

// =============================================
// EXERCISE QUESTION — Question d'un exercice
// =============================================

model ExerciseQuestion {
  id         String       @id @default(uuid())
  text       String       @db.Text
  type       ExerciseType @default(QCM)
  position   Int          @default(0)
  points     Float        @default(1)
  correctAnswer String?   @db.Text // Pour TEXTE_LIBRE : réponse attendue (optionnel)
  imageUrl   String?      // Image d'illustration de la question

  exerciseId String
  exercise   ChapterExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  options ExerciseOption[]
  answers ExerciseAnswer[]

  @@index([exerciseId])
}

// =============================================
// EXERCISE OPTION — Option de réponse QCM/Vrai-Faux
// =============================================

model ExerciseOption {
  id        String @id @default(uuid())
  text      String
  isCorrect Boolean @default(false)
  imageUrl  String? // Image d'illustration de l'option (optionnel)

  questionId String
  question   ExerciseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answers ExerciseAnswer[]

  @@index([questionId])
}

// =============================================
// EXERCISE SUBMISSION — Soumission d'un apprenant
// =============================================

model ExerciseSubmission {
  id       String @id @default(uuid())
  score    Float?
  maxScore Float?
  feedback String? @db.Text

  studentId  String
  student    User   @relation("ExerciseSubmitter", fields: [studentId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   ChapterExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  answers ExerciseAnswer[]

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, exerciseId])
  @@index([exerciseId])
  @@index([studentId])
}

// =============================================
// EXERCISE ANSWER — Réponse à une question
// =============================================

model ExerciseAnswer {
  id        String @id @default(uuid())
  textValue String? @db.Text // Pour TEXTE_LIBRE
  isCorrect Boolean?

  submissionId String
  submission   ExerciseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   ExerciseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionId String?
  option   ExerciseOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([questionId])
}

// =============================================
// SYSTEM SETTING — Paramètres Globaux Plateforme
// =============================================

model SystemSetting {
  id            String   @id @default("default")
  platformName  String   @default("École 3.0 / SEEEC Platform")
  logoUrl       String?
  signatureUrl  String?
  stampUrl      String?
  email         String?
  phone         String?
  address       String?
  postalAddress String?
  websiteUrl    String?
  description   String?  @db.Text
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}
